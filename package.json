{
  "name": "dsh-superagent-wechat-source",
  "version": "0.1.0",
  "description": "Personal WeChat (iLink ClawBot) as a dsh-superagent Source: DM your bot, it decides whether the message is work, and the result comes back in the same chat.",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.0 <0.3.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.28",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "luckyxiang6688",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-superagent",
    "source",
    "wechat",
    "weixin",
    "ilink",
    "clawbot",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luckyxiang6688/dsh-superagent-wechat-source.git"
  },
  "homepage": "https://github.com/luckyxiang6688/dsh-superagent-wechat-source#readme",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "package.json"
  ]
}
